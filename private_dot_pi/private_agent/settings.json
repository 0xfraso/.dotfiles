{
  "lastChangelogVersion": "1.2.0",
  "theme": "gruber-darker",
  "defaultProvider": "zai",
  "defaultModel": "glm-5.3",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": false,
  "showHardwareCursor": true,
  "editorPaddingX": 1,
  "packages": [
    "git:github.com/nicobailon/pi-web-access",
    "git:github.com/nicobailon/pi-subagents",
    "git:github.com/MasuRii/pi-rtk-optimizer",
    "git:github.com/nicobailon/pi-mcp-adapter",
    "git:github.com/juhas96/graphify-pi"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "quietStartup": true,
  "skills": [
    "~/.pi/agent/extensions/headroom/skills"
  ]
